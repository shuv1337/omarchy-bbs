#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export XDG_STATE_HOME="$plugin_dir/.local-test/state"
export XDG_CONFIG_HOME="$plugin_dir/.local-test/config"
export OMARCHY_BBS_URL="http://127.0.0.1:8765"
exec python3 "$plugin_dir/client.py" "$@"
